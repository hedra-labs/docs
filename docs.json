{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Hedra",
  "colors": {
    "primary": "#181818",
    "light": "#F8F8F8",
    "dark": "#D0D0D0"
  },
  "fonts": {
    "family": "Geist"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/logo/light.svg",
    "dark": "/assets/logo/dark.svg",
    "href": "https://www.hedra.com"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "icon": "headset",
          "href": "https://www.hedra.com/support"
        },
        {
          "anchor": "Community",
          "icon": "discord",
          "href": "https://discord.com/invite/KXeUUa6cXD"
        },
        {
          "anchor": "API Dashboard",
          "icon": "layout-dashboard",
          "href": "https://www.hedra.com/app/settings/api"
        }
      ]
    },
    "products": [
      {
        "product": "Agent platform",
        "description": "Create with the agent and manual tools",
        "icon": "message-circle",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "pages/app/getting-started/overview",
              "pages/app/getting-started/start-with-an-idea",
              "pages/app/getting-started/spaces",
              "pages/app/getting-started/multiplayer",
              "pages/app/getting-started/library"
            ]
          },
          {
            "group": "Build with the agent",
            "pages": [
              "pages/app/getting-started/references-and-elements",
              "pages/app/getting-started/skills-and-connectors"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "pages/app/content-creation/create-image",
              "pages/app/content-creation/animate-your-photos",
              "pages/app/content-creation/how-to-create-ugc-ads",
              "pages/app/content-creation/create-avatar-video",
              "pages/app/content-creation/creating-music-videos",
              "pages/app/content-creation/how-to-swap-your-face"
            ]
          },
          {
            "group": "Manual tools",
            "pages": [
              "pages/app/getting-started/manual-tools",
              "pages/app/getting-started/manual-image",
              "pages/app/getting-started/video-models",
              "pages/app/content-creation/create-audio",
              "pages/app/content-creation/edit-videos-in-composer"
            ]
          },
          {
            "group": "Credits & Billing",
            "pages": [
              "pages/app/billing/generation-history",
              "pages/app/billing/annual-subscriptions",
              "pages/app/billing/payment-methods",
              "pages/app/billing/change-plan",
              "pages/app/billing/cancel-subscription",
              "pages/app/billing/how-credits-work"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "pages/app/account/forgot-password",
              "pages/app/account/delete-account",
              "pages/app/account/creator-program"
            ]
          }
        ]
      },
      {
        "product": "Developer platform",
        "description": "Unified accelerated inference for visual media",
        "icon": "code",
        "groups": [
          {
            "group": "Guides",
            "pages": [
              "pages/developer/v3/chain-generations"
              "pages/developer/v3/model-catalog"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "pages/developer/v3/quality-levels"
            ]
          },
          {
            "group": "API Reference",
            "openapi": {
              "source": "/openapi-v3.json",
              "directory": "api-reference/v3"
            }
          }
        ]
      },
      {
        "product": "Legacy API",
        "description": "The v2 generations API, supported for existing integrations",
        "icon": "archive",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "pages/developer/getting_started/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "pages/developer/guides/generate-image",
              "pages/developer/guides/generate-video",
              "pages/developer/guides/generate-avatar-video",
              "pages/developer/guides/generate-audio",
              "pages/developer/guides/automate-with-n8n"
            ]
          },
          {
            "group": "API Reference",
            "openapi": "/openapi.json",
            "pages": [
              "GET /models",
              "GET /voices",
              "GET /assets",
              "POST /assets",
              "POST /assets/{id}/upload",
              "GET /generations",
              "POST /generations",
              "GET /generations/{generation_id}/status",
              "GET /billing/credits"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/pages/developer/realtime-avatar",
      "destination": "/pages/developer/getting_started/quickstart"
    },
    {
      "source": "/pages/developer/realtime-avatar/:slug*",
      "destination": "/pages/developer/getting_started/quickstart"
    },
    {
      "source": "/pages/app/content-creation/create-element",
      "destination": "/pages/app/getting-started/references-and-elements"
    },
    {
      "source": "/pages/app/content-creation/elements-101-beginners-guide",
      "destination": "/pages/app/getting-started/references-and-elements"
    },
    {
      "source": "/pages/app/content-creation/elements-201-content-creators",
      "destination": "/pages/app/getting-started/references-and-elements"
    },
    {
      "source": "/pages/app/content-creation/speaker-selection",
      "destination": "/pages/app/content-creation/create-avatar-video"
    },
    {
      "source": "/pages/app/content-creation/upscale-video",
      "destination": "/pages/app/content-creation/edit-videos-in-composer"
    },
    {
      "source": "/pages/app/getting-started/video-tutorials",
      "destination": "/pages/app/getting-started/overview"
    }
  ],
  "navbar": {},
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "perplexity",
      "chatgpt"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hedra_labs",
      "github": "https://github.com/hedra-labs",
      "linkedin": "https://linkedin.com/company/hedra-labs",
      "discord": "https://discord.com/invite/KXeUUa6cXD"
    }
  },
  "background": {
    "color": {
      "light": "#E3E3E3",
      "dark": "#181818"
    }
  },
  "appearance": {
    "default": "system"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://www.hedra.com/docs"
    }
  },
  "icons": {
    "library": "tabler"
  }
